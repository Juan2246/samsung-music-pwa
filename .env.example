# Copia este archivo como .env.local y completa los valores.
# .env.local está en .gitignore: nunca subas tus claves al repositorio.
#
# Spotify Web API (flujo Client Credentials).
# Solo hacen falta para leer álbumes y playlists de Spotify con la API oficial.
# Créalas gratis en https://developer.spotify.com/dashboard
# Sin ellas, la búsqueda de canciones y los enlaces de YouTube / YouTube Music siguen funcionando.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
