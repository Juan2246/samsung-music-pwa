# Copia este archivo como .env.local y completa los valores.
# .env.local está en .gitignore: nunca subas tus claves al repositorio.

# ── Spotify Web API (flujo Client Credentials) ─────────────────────────────
# Opcionales. Solo sirven para leer álbumes y playlists de Spotify completos
# con la API oficial. Créalas gratis en https://developer.spotify.com/dashboard
# Ojo: desde 2026 Spotify exige que la cuenta dueña de la app tenga Premium;
# si no, la API responde 403 y la app usa el método sin claves (máx. 100 pistas).
# Sin claves, la búsqueda de canciones y los enlaces de YouTube / YouTube Music
# funcionan igual.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── yt-dlp ─────────────────────────────────────────────────────────────────
# Opcional. Ruta completa al ejecutable si no está en el PATH ni en la raíz
# del proyecto. Ejemplo en Windows: C:\herramientas\yt-dlp.exe
YTDLP_PATH=
